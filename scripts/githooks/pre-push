#!/bin/bash
# 公開ゲート: push対象コミットで変更された articles/*.md のうち published: true の
# ものに記事lint（scripts/article-lint.sh）を実行し、FAILなら push を拒否する。
# 意図的に飛ばす場合のみ git push --no-verify（本人の明示判断として許容）。
# 有効化: git config core.hooksPath scripts/githooks
set -u
REPO_ROOT="$(git rev-parse --show-toplevel)"
ZERO="0000000000000000000000000000000000000000"
STATUS=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue  # ブランチ削除pushは対象外
  if [ "$remote_sha" = "$ZERO" ]; then
    base="$(git rev-parse origin/main 2>/dev/null || echo "$local_sha")"  # 新規ブランチ
  else
    base="$remote_sha"
  fi
  for f in $(git diff --name-only "$base" "$local_sha" -- 'articles/*.md' 2>/dev/null); do
    git cat-file -e "$local_sha:$f" 2>/dev/null || continue  # 削除ファイル
    git show "$local_sha:$f" | sed -n '1,20p' | grep -q '^published: *true' || continue
    tmpdir="$(mktemp -d)"
    git show "$local_sha:$f" > "$tmpdir/$(basename "$f")"
    echo "── 公開ゲート: ${f}（published: true）→ 記事lint ──"
    (cd "$REPO_ROOT" && ./scripts/article-lint.sh "$tmpdir/$(basename "$f")") < /dev/null || STATUS=1
    rm -rf "$tmpdir"
  done
done

if [ "$STATUS" -ne 0 ]; then
  echo ""
  echo "PUSH REJECTED: published: true の記事が記事lintをFAILしています。"
  echo "修正して再push してください（意図的に飛ばす場合のみ git push --no-verify）。"
  exit 1
fi
exit 0
