{
  "_comment": "プロファイル: zenn（Zenn記事）。設定なしで npx textlint を叩いたときもこれが使われる。他は .textlintrc.common.json / .textlintrc.resume.json",
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": { "max": 90 },
      "max-comma": { "max": 3 },
      "max-ten": { "max": 3 },
      "no-exclamation-question-mark": false,
      "ja-no-weak-phrase": true,
      "ja-no-redundant-expression": true,
      "no-doubled-joshi": { "strict": false }
    },
    "prh": {
      "rulePaths": ["./prh-common.yml", "./prh-zenn.yml"]
    }
  }
}
